[Unit]
Description=Clawbot Hardware Service (Rosmaster + Camera bridge)
Documentation=https://github.com/openclaw/openclaw
After=network.target

[Service]
Type=simple
User=jetson
Group=dialout
WorkingDirectory=/home/jetson/ros2_llm_bridge
ExecStart=/usr/bin/python3 /home/jetson/ros2_llm_bridge/hardware_service.py
Restart=on-failure
RestartSec=5
Environment=ROSMASTER_PORT=/dev/myserial
Environment=WORKSPACE_PATH=/home/jetson/.openclaw/workspace
Environment=CAMERA_FRONT_INDEX=0
Environment=CAMERA_CLAW_INDEX=2
Environment=HARDWARE_SERVICE_PORT=8001

[Install]
WantedBy=multi-user.target
