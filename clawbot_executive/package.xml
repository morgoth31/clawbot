<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>clawbot_executive</name>
  <version>0.1.0</version>
  <description>Serveur de skills (actions ROS 2) - P08</description>
  <maintainer email="jetson@clawbot.local">Clawbot</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>clawbot_interfaces</exec_depend>
  <exec_depend>clawbot_common</exec_depend>
  <!-- P13 : les skills du bras passent par l'action du controleur de trajectoire et
       convertissent les angles de servo avec sa table de correspondance. -->
  <exec_depend>clawbot_arm_controller</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-jsonschema</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
