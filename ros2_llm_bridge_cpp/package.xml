<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_llm_bridge_cpp</name>
  <version>2.0.0</version>
  <description>C++ reimplementation of the ROS 2 LLM Bridge — HTTP API exposing 17 robot tools for LLM function calling.</description>
  <maintainer email="jetson@example.com">jetson</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>

  <build_depend>nlohmann-json3-dev</build_depend>
  <build_depend>libcurl4-openssl-dev</build_depend>

  <exec_depend>libcurl4</exec_depend>
  <exec_depend>nlohmann-json3</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>