[Unit]
Description=Clawbot Lidar YDLIDAR TG30 (/scan) - frame_id alignee sur l URDF (laser_link)
After=network.target

[Service]
Type=simple
User=jetson
Group=jetson
WorkingDirectory=/home/jetson/yahboomcar_ros2_ws/software/library_ws
Environment=ROS_DOMAIN_ID=28
ExecStart=/bin/bash -c "source /opt/ros/humble/setup.bash && source install/setup.bash && exec ros2 launch ydlidar_ros2_driver ydlidar_raw_launch.py params_file:=/home/jetson/clawbot/config/ydlidar_x3plus.yaml"
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
