[Unit]
StartLimitBurst=5
StartLimitIntervalSec=60
Description=Clawbot Lidar YDLIDAR TG30 (/scan) - frame_id alignee sur l URDF (laser_link)
After=network.target

[Service]
EnvironmentFile=/home/jetson/clawbot/deploy/env/clawbot.env
Type=simple
User=jetson
Group=jetson
WorkingDirectory=/home/jetson/yahboomcar_ros2_ws/software/library_ws
ExecStart=/bin/bash -c "set +u; source /opt/ros/humble/setup.bash; source /home/jetson/clawbot/install/setup.bash; set -u; exec ros2 launch clawbot_bringup lidar.launch.py"
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=clawbot.target
