<?xml version="1.0" encoding="utf-8"?>
<robot name="clawbot_x3plus">
  <!-- Genere depuis urdf/clawbot_x3plus.urdf : chaines, etats nommes, ACM.
       Regenerer avec scripts/generate_srdf.py apres toute modification de l URDF. -->

  <group name="arm">
    <chain base_link="base_link" tip_link="arm_link5"/>
  </group>

  <group name="gripper">
    <joint name="grip_joint"/>
  </group>

  <end_effector name="gripper" parent_link="arm_link5" group="gripper" parent_group="arm"/>

  <group_state name="repos" group="arm">
    <joint name="arm_joint1" value="0.000000"/>
    <joint name="arm_joint2" value="1.570796"/>
    <joint name="arm_joint3" value="-1.570796"/>
    <joint name="arm_joint4" value="-1.570796"/>
    <joint name="arm_joint5" value="0.000000"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="grip_joint" value="-1.540000"/>
  </group_state>

  <group_state name="closed" group="gripper">
    <joint name="grip_joint" value="0.000000"/>
  </group_state>

  <!-- Paires dont la verification de collision est desactivee (adjacence 1 et 2). -->
  <disable_collisions link1="arm_link1" link2="arm_link2" reason="Adjacent"/>
  <disable_collisions link1="arm_link1" link2="arm_link3" reason="Adjacent"/>
  <disable_collisions link1="arm_link1" link2="base_footprint" reason="Adjacent"/>
  <disable_collisions link1="arm_link1" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="arm_link2" link2="arm_link3" reason="Adjacent"/>
  <disable_collisions link1="arm_link2" link2="arm_link4" reason="Adjacent"/>
  <disable_collisions link1="arm_link2" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="arm_link3" link2="arm_link4" reason="Adjacent"/>
  <disable_collisions link1="arm_link3" link2="arm_link5" reason="Adjacent"/>
  <disable_collisions link1="arm_link3" link2="mono_link" reason="Adjacent"/>
  <disable_collisions link1="arm_link4" link2="arm_link5" reason="Adjacent"/>
  <disable_collisions link1="arm_link4" link2="mono_link" reason="Adjacent"/>
  <disable_collisions link1="arm_link5" link2="llink1" reason="Adjacent"/>
  <disable_collisions link1="arm_link5" link2="llink2" reason="Adjacent"/>
  <disable_collisions link1="arm_link5" link2="llink3" reason="Adjacent"/>
  <disable_collisions link1="arm_link5" link2="rlink1" reason="Adjacent"/>
  <disable_collisions link1="arm_link5" link2="rlink2" reason="Adjacent"/>
  <disable_collisions link1="arm_link5" link2="rlink3" reason="Adjacent"/>
  <disable_collisions link1="back_left_wheel" link2="base_footprint" reason="Adjacent"/>
  <disable_collisions link1="back_left_wheel" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="back_right_wheel" link2="base_footprint" reason="Adjacent"/>
  <disable_collisions link1="back_right_wheel" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="base_footprint" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="base_footprint" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="base_footprint" link2="front_left_wheel" reason="Adjacent"/>
  <disable_collisions link1="base_footprint" link2="front_right_wheel" reason="Adjacent"/>
  <disable_collisions link1="base_footprint" link2="imu_link" reason="Adjacent"/>
  <disable_collisions link1="base_footprint" link2="laser_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="front_left_wheel" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="front_right_wheel" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="imu_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="laser_link" reason="Adjacent"/>
  <disable_collisions link1="llink1" link2="llink2" reason="Adjacent"/>
  <disable_collisions link1="rlink1" link2="rlink2" reason="Adjacent"/>

</robot>
