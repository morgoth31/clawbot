# Environnement commun aux unites du robot (P14, REQ-OPS-041).
#
# Un seul endroit pour ROS_DOMAIN_ID : les unites le lisent par `EnvironmentFile=`.
# Changer de domaine (essai, simulation) est une modification de ce fichier, pas de
# vingt fichiers d'unite.
ROS_DOMAIN_ID=28
# Les noeuds lisent leurs seuils hors paquet a ces chemins (installation, pas source).
CLAWBOT_PRECONDITIONS=/home/jetson/clawbot/install/clawbot_bringup/share/clawbot_bringup/config/preconditions.yaml
CLAWBOT_ARM_POSES=/home/jetson/clawbot/install/clawbot_bringup/share/clawbot_bringup/config/arm_poses.yaml
