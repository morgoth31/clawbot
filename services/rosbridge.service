[Unit]
Description=Clawbot ROS2 WebSocket Bridge (Foxglove / rosbridge port 9090)
After=network.target ros2-driver-node.service
Requires=ros2-driver-node.service

[Service]
Type=simple
User=jetson
Group=jetson
ExecStart=/bin/bash -c "source /opt/ros/humble/setup.bash && \
  source /home/jetson/yahboomcar_ros2_ws/yahboomcar_ws/install/setup.bash && \
  ROS_DOMAIN_ID=28 ros2 launch rosbridge_server rosbridge_websocket_launch.xml port:=9090"
Restart=on-failure
RestartSec=5
Environment=ROS_DOMAIN_ID=28

[Install]
WantedBy=multi-user.target
