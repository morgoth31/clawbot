[Unit]
Description=Clawbot ROS2 Driver Node (Mcnamu_driver_X3 — cmd_vel → serial)
After=network.target ros2-hardware-service.service
Requires=ros2-hardware-service.service

[Service]
Type=simple
User=jetson
Group=jetson
WorkingDirectory=/home/jetson/yahboomcar_ros2_ws/yahboomcar_ws
ExecStart=/bin/bash -c "source /opt/ros/humble/setup.bash && \
  source /home/jetson/yahboomcar_ros2_ws/yahboomcar_ws/install/setup.bash && \
  ros2 run yahboomcar_bringup Mcnamu_driver_X3"
Restart=on-failure
RestartSec=5
Environment=ROS_DOMAIN_ID=28

[Install]
WantedBy=multi-user.target
