[Unit]
Description=Clawbot ROS2 Driver Node (clawbot_base_driver — cmd_vel_safe → serial)
After=network.target ros2-hardware-service.service
Requires=ros2-hardware-service.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
EnvironmentFile=/home/jetson/clawbot/deploy/env/clawbot.env
Type=simple
User=jetson
Group=jetson
WorkingDirectory=/home/jetson/clawbot
ExecStart=/bin/bash -c "set +u; source /opt/ros/humble/setup.bash; source /home/jetson/clawbot/install/setup.bash; set -u; exec ros2 launch clawbot_bringup base.launch.py"
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=clawbot.target
