[Unit]
Description=Clawbot ROS2 Driver Node (clawbot_base_driver — cmd_vel_safe → serial)
After=network.target ros2-hardware-service.service
Requires=ros2-hardware-service.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=jetson
Group=jetson
WorkingDirectory=/home/jetson/clawbot
ExecStart=/bin/bash -c "source /opt/ros/humble/setup.bash && \
  source /home/jetson/clawbot/install/setup.bash && \
  exec ros2 run clawbot_base_driver driver_node"
Restart=on-failure
RestartSec=2
Environment=ROS_DOMAIN_ID=28
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
