[Unit]
Description=Gestionnaire de capacites (liste blanche, conflits, etats) - Clawbot X3 Plus
Documentation=file:///home/jetson/clawbot/docs/architecture/cible.md
After=network.target ros2-driver-node.service clawbot-safety-arbitrator.service
Wants=ros2-driver-node.service clawbot-safety-arbitrator.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
EnvironmentFile=/home/jetson/clawbot/deploy/env/clawbot.env
Type=simple
User=jetson
Group=jetson
Environment=HOME=/home/jetson
WorkingDirectory=/home/jetson/clawbot
# Le manifeste est lu par defaut dans l'installation (`share/clawbot_capabilities/config/`),
# pas passe en --params-file : ce n'est pas un fichier de parametres ROS.
ExecStart=/bin/bash -c "set +u; source /opt/ros/humble/setup.bash; source /home/jetson/clawbot/install/setup.bash; set -u; exec ros2 launch clawbot_bringup capabilities.launch.py"
# L'autorisation sudo est bornee aux unites du manifeste :
#   /etc/sudoers.d/clawbot-capabilities (deploy/sudoers/clawbot-capabilities)
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGINT

[Install]
WantedBy=clawbot.target
