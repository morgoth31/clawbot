[Unit]
Description=Clawbot C++ LLM Bridge (port 8000)
After=network.target ros2-hardware-service.service
Requires=ros2-hardware-service.service

[Service]
Type=simple
User=jetson
Group=jetson
WorkingDirectory=/home/jetson/clawbot
ExecStart=/bin/bash -c "source /opt/ros/humble/setup.bash && \
  source /home/jetson/clawbot/install/setup.bash && \
  export ROS_DOMAIN_ID=28 && \
  export HARDWARE_SERVICE_URL=http://localhost:8001 && \
  export YOLO_SERVICE_URL=http://localhost:8003 && \
  export BRIDGE_PORT=8000 && \
  /home/jetson/clawbot/install/ros2_llm_bridge_cpp/lib/ros2_llm_bridge_cpp/api_server"
Restart=on-failure
RestartSec=3
Environment=ROS_DOMAIN_ID=28
Environment=HARDWARE_SERVICE_URL=http://localhost:8001
Environment=YOLO_SERVICE_URL=http://localhost:8003
Environment=BRIDGE_PORT=8000

[Install]
WantedBy=multi-user.target