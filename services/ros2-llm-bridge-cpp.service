[Unit]
Description=Clawbot C++ LLM Bridge (port 8000)
After=network.target ros2-hardware-service.service
Requires=ros2-hardware-service.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
EnvironmentFile=/home/jetson/clawbot/deploy/env/clawbot.env
Type=simple
User=jetson
Group=jetson
WorkingDirectory=/home/jetson/clawbot
ExecStart=/bin/bash -c "set +u; source /opt/ros/humble/setup.bash; source /home/jetson/clawbot/install/setup.bash; set -u; exec ros2 launch clawbot_bringup api.launch.py"
Restart=on-failure
RestartSec=2
Environment=HARDWARE_SERVICE_URL=http://localhost:8001
Environment=YOLO_SERVICE_URL=http://localhost:8003
Environment=BRIDGE_PORT=8000
TimeoutStopSec=10

[Install]
WantedBy=clawbot.target
