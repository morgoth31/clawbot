[Unit]
Description=Sentinel S1 - attention, mots d'arret, reveil S2
After=network.target orbbec-camera.service clawbot-director.service
Requires=clawbot-director.service

[Service]
Type=simple
User=jetson
Group=jetson
Environment=ROS_DOMAIN_ID=28
Environment=HOME=/home/jetson
WorkingDirectory=/home/jetson/clawbot
ExecStart=/bin/bash -c "source /opt/ros/humble/setup.bash && source install/setup.bash && exec python3 -c 'from clawbot_sentinel.sentinel_node import main; main()'"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
