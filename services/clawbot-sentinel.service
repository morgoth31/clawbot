[Unit]
Description=Sentinel S1 - attention, mots d'arret, reveil S2
After=network.target orbbec-camera.service clawbot-director.service
Requires=clawbot-director.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
EnvironmentFile=/home/jetson/clawbot/deploy/env/clawbot.env
Type=simple
User=jetson
Group=jetson
Environment=HOME=/home/jetson
WorkingDirectory=/home/jetson/clawbot
ExecStart=/bin/bash -c "set +u; source /opt/ros/humble/setup.bash; source /home/jetson/clawbot/install/setup.bash; set -u; exec ros2 launch clawbot_bringup sentinel.launch.py"
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
KillSignal=SIGINT

[Install]
WantedBy=clawbot.target
