[Unit]
Description=Caméra du poignet (USB 0c45:6340) dans ROS 2 - /wrist_camera/image_raw
After=network.target clawbot-description.service
# La caméra est un périphérique exclusif en V4L2 : deux processus qui l'ouvrent se volent les
# tampons et le second meurt sur « Failed mapping device memory », sans erreur côté appelant.
# Ce service en est le propriétaire unique ; yolo-inference.service lit /wrist_camera/image_raw
# (CAMERA_CLAW_SOURCE=ros) au lieu d'ouvrir /dev/video0.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=jetson
Environment=ROS_DOMAIN_ID=28
Environment=HOME=/home/jetson
# `brightness`/`gain` sont des paramètres de démarrage, pas des réglages d'ambiance : sans eux, un
# redémarrage ramène l'image à une luminance de 19 (mesuré) et la caméra devient inutilisable dans
# une pièce sombre. Le module n'expose pas de contrôle d'exposition, le gain est le seul levier.
#
# Valeurs mesurées le 2026-11-11 : à `brightness=60` / `gain=70`, les 307 200 pixels valaient 255 —
# image entièrement blanche en scène proche et éclairée. À `0` / `0` : min 8, max 224, écart-type 61,
# structure lisible. Le gain est donc ramené à 0 ; en lumière faible, le remonter par paliers en
# vérifiant la fraction de pixels saturés (`scripts/sonde_flux_camera.py`).
#
# Chemin by-id et non /dev/videoN : l'index dépend de l'ordre d'énumération USB, le nom by-id non.
# L'appareil expose deux nœuds (video0 = capture, video1 = métadonnées) : index0 est le bon.
ExecStart=/bin/bash -c "source /opt/ros/humble/setup.bash && exec ros2 run v4l2_camera v4l2_camera_node --ros-args -r __ns:=/wrist_camera -r __node:=camera -p video_device:=/dev/v4l/by-id/usb-Sonix_Technology_Co.__Ltd._USB_2.0_Camera-video-index0 -p image_size:='[640, 480]' -p time_per_frame:='[1, 15]' -p pixel_format:=YUYV -p output_encoding:=yuv422_yuy2 -p camera_frame_id:=wrist_camera_optical_frame -p brightness:=0 -p gain:=0 -p camera_info_url:=file:///home/jetson/clawbot/config/wrist_camera_info.yaml"
Restart=on-failure
RestartSec=2
# Un arrêt doit rendre le périphérique proprement : sans SIGINT, le descripteur reste mappé
# quelques secondes et le redémarrage échoue sur son propre cadavre.
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
