# Clawbot — lidar YDLIDAR TG30
#
# Constat du 2026-11-10 : le capteur est présent et sain (TG30, firmware 1.71, 512 000 Bd,
# 20 K points/s, 10 Hz) et son pilote est compilé dans
# yahboomcar_ros2_ws/software/library_ws. Aucune unité ne le lançait : `/scan` n'existait
# donc pas, et les pages de la base concluaient à tort à l'absence de lidar
# (ERR-2026-11-10-001, corrigée).
#
# Le port /dev/ydlidar est fourni par /etc/udev/rules.d/ydlidar.rules (CP2102 10c4:ea60).
# Le pilote est un nœud de cycle de vie : la launch le configure et l'active.

[Unit]
Description=Clawbot Lidar YDLIDAR TG30 (/scan)
Documentation=file:///home/jetson/clawbot/docs/knowledge-base/03_Operations/errors_traces/ERR-2026-11-10-001_absence_topic_scan.md
After=network.target

[Service]
Type=simple
User=jetson
Group=jetson
WorkingDirectory=/home/jetson/yahboomcar_ros2_ws/software/library_ws
Environment=ROS_DOMAIN_ID=28
ExecStart=/bin/bash -c "source /opt/ros/humble/setup.bash && \
  source install/setup.bash && \
  exec ros2 launch ydlidar_ros2_driver ydlidar_raw_launch.py"
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
