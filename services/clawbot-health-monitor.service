[Unit]
Description=Moniteur de sante des flux - Clawbot X3 Plus
Documentation=file:///home/jetson/clawbot/docs/architecture/cible.md
After=network.target ros2-driver-node.service
Wants=ros2-driver-node.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
EnvironmentFile=/home/jetson/clawbot/deploy/env/clawbot.env
Type=simple
User=jetson
Group=jetson
Environment=HOME=/home/jetson
WorkingDirectory=/home/jetson/clawbot
# N'utilise pas clawbot-health.service : celle-ci est un oneshot Telegram
# (bridge_mcp.health), sans rapport avec la surveillance des flux.
ExecStart=/bin/bash -c "set +u; source /opt/ros/humble/setup.bash; source /home/jetson/clawbot/install/setup.bash; set -u; exec ros2 launch clawbot_bringup health.launch.py"
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
KillSignal=SIGINT

[Install]
WantedBy=clawbot.target
