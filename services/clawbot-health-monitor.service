[Unit]
Description=Moniteur de sante des flux - Clawbot X3 Plus
Documentation=file:///home/jetson/clawbot/docs/architecture/cible.md
After=network.target ros2-driver-node.service
Wants=ros2-driver-node.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=jetson
Group=jetson
Environment=ROS_DOMAIN_ID=28
Environment=HOME=/home/jetson
WorkingDirectory=/home/jetson/clawbot
# N'utilise pas clawbot-health.service : celle-ci est un oneshot Telegram
# (bridge_mcp.health), sans rapport avec la surveillance des flux.
ExecStart=/bin/bash -c "source /opt/ros/humble/setup.bash && source install/setup.bash && exec /home/jetson/clawbot/install/clawbot_health/lib/clawbot_health/health_monitor"
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
