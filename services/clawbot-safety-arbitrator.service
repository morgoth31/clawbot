[Unit]
Description=Arbitre reflexe S1 - Clawbot X3 Plus
After=network.target ros2-driver-node.service
Requires=ros2-driver-node.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
EnvironmentFile=/home/jetson/clawbot/deploy/env/clawbot.env
Type=simple
User=jetson
Group=jetson
Environment=HOME=/home/jetson
WorkingDirectory=/home/jetson/clawbot
ExecStart=/bin/bash -c "set +u; source /opt/ros/humble/setup.bash; source /home/jetson/clawbot/install/setup.bash; set -u; exec ros2 launch clawbot_bringup safety.launch.py"
# Boucle de sûreté à 20 Hz mono-thread : priorité d'ordonnancement et cœur dédié.
# CPUAffinity=4 : cœur le moins chargé mesuré en P01-M07 (22,1 %).
Nice=-10
CPUAffinity=4
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
KillSignal=SIGINT

[Install]
WantedBy=clawbot.target
