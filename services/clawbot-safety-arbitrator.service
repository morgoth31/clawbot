[Unit]
Description=Arbitre reflexe S1 - Clawbot X3 Plus
After=network.target ros2-driver-node.service
Requires=ros2-driver-node.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=jetson
Group=jetson
Environment=ROS_DOMAIN_ID=28
Environment=HOME=/home/jetson
WorkingDirectory=/home/jetson/clawbot
ExecStart=/bin/bash -c "source /opt/ros/humble/setup.bash && source install/setup.bash && exec python3 -c 'from clawbot_safety.arbitrator import main; main()' --ros-args --params-file /home/jetson/clawbot/install/clawbot_safety/share/clawbot_safety/config/arbitrator.yaml"
# Boucle de sûreté à 20 Hz mono-thread : priorité d'ordonnancement et cœur dédié.
# CPUAffinity=4 : cœur le moins chargé mesuré en P01-M07 (22,1 %).
Nice=-10
CPUAffinity=4
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
