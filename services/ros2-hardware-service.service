[Unit]
Description=Clawbot Hardware Service (ROS2 bridge — no serial conflict)
After=network.target

[Service]
Type=simple
User=jetson
Group=jetson
WorkingDirectory=/home/jetson/clawbot/ros2_llm_bridge
ExecStart=/bin/bash -c "source /opt/ros/humble/setup.bash && \
  source /home/jetson/yahboomcar_ros2_ws/yahboomcar_ws/install/setup.bash && \
  python3 /home/jetson/clawbot/ros2_llm_bridge/hardware_service.py"
Restart=on-failure
RestartSec=5
Environment=ROS_DOMAIN_ID=28
Environment=WORKSPACE_PATH=/home/jetson/clawbot/workspace
Environment=CAMERA_FRONT_INDEX=0
# Caméra du bras = seul périphérique UVC du bus, sur /dev/video0 (0c45:6340). L'index 2
# n'existe pas : « claw » répondait 500. « front » pointe encore sur le même périphérique
# tant que la vue avant (Astra, /camera/color/image_raw) n'est pas servie en ROS.
Environment=CAMERA_CLAW_INDEX=0
Environment=HARDWARE_SERVICE_PORT=8001
Environment=MAX_LINEAR_MS=0.06
Environment=MAX_ANGULAR_RS=0.25
Environment=MOTION_WATCHDOG_S=1.5
Environment=LIDAR_SAFETY_REQUIRED=false

[Install]
WantedBy=multi-user.target
