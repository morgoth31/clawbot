[Unit]
Description=Detection d'objets YOLO dans le graphe (yolo_node + facade HTTP 8003) - Clawbot X3 Plus
Documentation=file:///home/jetson/clawbot/docs/architecture/cible.md
After=network.target clawbot-wrist-camera.service clawbot-capability-manager.service
Wants=clawbot-wrist-camera.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
EnvironmentFile=/home/jetson/clawbot/deploy/env/clawbot.env
Type=simple
User=jetson
Group=jetson
Environment=HOME=/home/jetson
Environment=ROS_LOG_DIR=/var/lib/clawbot/ros-log
Environment=YOLO_MODEL_PATH=/home/jetson/software/yolov5-7.0/yolov5s.pt
# torch.hub ecrit dans ~/.cache/torch, interdit par ProtectHome=read-only
Environment=TORCH_HOME=/var/lib/clawbot/torch
Environment=MPLCONFIGDIR=/var/lib/clawbot/mpl
WorkingDirectory=/home/jetson/clawbot
# Le venv yolov5 porte torch CUDA ; ROS est source pour rclpy (python 3.10 des deux cotes).
# La facade HTTP 8003 est servie dans le meme processus (thread), pas un second service.
ExecStart=/bin/bash -c "set +u; source /opt/ros/humble/setup.bash; source /home/jetson/clawbot/install/setup.bash; set -u; exec ros2 launch clawbot_bringup detection.launch.py"
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
KillSignal=SIGINT

StateDirectory=clawbot
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=clawbot.target
