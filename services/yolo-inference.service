[Unit]
Description=Clawbot YOLO Inference Service (port 8003, CUDA)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=jetson
Group=jetson
# ROS est source pour que rclpy soit importable depuis le venv yolov5 (python 3.10 dans les deux
# cas) : la camera du poignet appartient a clawbot-wrist-camera.service, ce service lit l'image
# par le topic au lieu d'ouvrir /dev/video0 en concurrent (V4L2 exclusif).
ExecStart=/bin/bash -c "source /opt/ros/humble/setup.bash && exec /home/jetson/yolov5_env/bin/python3 /home/jetson/clawbot/yolo_service.py --port 8003"
Restart=on-failure
RestartSec=2
Environment=CAMERA_FRONT_INDEX=0
# La caméra du bras est le seul périphérique UVC du bus : elle produit /dev/video0
# (0c45:6340, port 1-2.2.1). L'index 2 n'existe pas — c'est pourquoi l'outil « claw »
# répondait 500. « front » pointe encore sur le même périphérique : la vue avant du
# robot est la caméra RGB-D Astra, publiée en ROS (/camera/color/image_raw), pas en V4L.
Environment=CAMERA_CLAW_INDEX=0
Environment=CAMERA_CLAW_SOURCE=ros
Environment=CAMERA_CLAW_ROS_TOPIC=/wrist_camera/image_raw
# Sans domaine explicite, le noeud cree par ce service vit en domaine 0 et ne voit rien du robot :
# un abonnement muet, sans erreur, cote appelant. Toutes les unites ROS de ce poste declarent 28.
Environment=ROS_DOMAIN_ID=28
Environment=HOME=/home/jetson
Environment=YOLO_MODEL_PATH=/home/jetson/software/yolov5-7.0/yolov5s.pt
Environment=WORKSPACE_PATH=/home/jetson/clawbot/workspace
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target