[Unit]
Description=Directeur S1 - Clawbot X3 Plus
After=network.target clawbot-safety-arbitrator.service
Requires=clawbot-safety-arbitrator.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=jetson
Group=jetson
Environment=ROS_DOMAIN_ID=28
Environment=HOME=/home/jetson
WorkingDirectory=/home/jetson/clawbot
ExecStart=/bin/bash -c "source /opt/ros/humble/setup.bash && source install/setup.bash && exec python3 -c 'from clawbot_director.director_node import main; main()'"
# Un arret ou un redemarrage n'annulait aucun goal en vol : la tache restait RUNNING cote serveurs
# d'action, sans personne pour l'attendre. ExecStop parle au noeud encore vivant.
ExecStop=/bin/bash /home/jetson/clawbot/scripts/annuler_tache_service.sh
TimeoutStopSec=10
Restart=on-failure
RestartSec=2
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
