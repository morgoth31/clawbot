[Unit]
Description=Clawbot Joy Teleop (Pro Controller / manette Bluetooth)
After=network.target bluetooth.target ros2-hardware-service.service ros2-driver-node.service
Wants=bluetooth.target
# Redémarre automatiquement si la manette se déconnecte
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=jetson
Environment=ROS_DOMAIN_ID=28
Environment=HOME=/home/jetson
# Attend la manette puis lance le teleop
ExecStart=/home/jetson/clawbot/joy_teleop/joy_teleop_wait.sh
# Redémarre si la manette disparaît (déconnexion BT)
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
