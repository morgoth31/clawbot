[Unit]
Description=Clawbot Joy Teleop (Pro Controller / manette Bluetooth)
After=network.target bluetooth.target ros2-hardware-service.service ros2-driver-node.service
Wants=bluetooth.target
# Redémarre automatiquement si la manette se déconnecte
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
TimeoutStopSec=10
EnvironmentFile=/home/jetson/clawbot/deploy/env/clawbot.env
Type=simple
User=jetson
Environment=HOME=/home/jetson
Environment=MANETTE_CONFIG=/home/jetson/clawbot/config/manette.yaml
# Attend la manette puis lance le teleop
ExecStart=/bin/bash -c "set +u; source /opt/ros/humble/setup.bash; source /home/jetson/clawbot/install/setup.bash; set -u; exec ros2 launch clawbot_bringup teleop.launch.py"
# Redémarre si la manette disparaît (déconnexion BT)
Restart=on-failure
RestartSec=5

[Install]
WantedBy=clawbot.target
