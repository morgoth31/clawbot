[Unit]
Description=SLAM Toolbox (cartographie) - Clawbot X3 Plus
After=network.target ros2-driver-node.service clawbot-ekf.service
Requires=ros2-driver-node.service
# SLAM Toolbox en cartographie publie map -> odom ; AMCL aussi. Deux ecrivains pour une
# transformation, c'est le meme defaut que deux editeurs pour /cmd_vel : les deux unites se
# declarent mutuellement incompatibles.
Conflicts=clawbot-nav2.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# En root, la decouverte DDS est isolee : le noeud publie mais reste invisible du graphe.
User=jetson
Environment=ROS_DOMAIN_ID=28
Environment=HOME=/home/jetson
ExecStart=/bin/bash -c "source /opt/ros/humble/setup.bash && exec ros2 run slam_toolbox async_slam_toolbox_node --ros-args -p base_frame:=base_link -p odom_frame:=odom -p map_frame:=map -p scan_topic:=/scan -p mode:=mapping -p use_sim_time:=false -p resolution:=0.05 -p minimum_travel_distance:=0.2 -p minimum_travel_heading:=0.2 -p map_update_interval:=2.0"
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
