<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>clawbot_bringup</name>
  <version>0.1.0</version>
  <description>Point d'entree unique du robot : un fichier de lancement par unite (P14)</description>
  <maintainer email="jetson@clawbot.local">Clawbot</maintainer>
  <license>Proprietary</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>clawbot_base_driver</exec_depend>
  <exec_depend>clawbot_safety</exec_depend>
  <exec_depend>clawbot_capabilities</exec_depend>
  <exec_depend>clawbot_executive</exec_depend>
  <exec_depend>clawbot_director</exec_depend>
  <exec_depend>clawbot_sentinel</exec_depend>
  <exec_depend>clawbot_health</exec_depend>
  <exec_depend>clawbot_arm_controller</exec_depend>
  <exec_depend>clawbot_moveit_config</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>ydlidar_ros2_driver</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
